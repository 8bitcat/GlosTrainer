@page
@model IndexModel
@{
    ViewData["Title"] = "GlosTrainer";
}

<section class="battle-canvas-shell" id="mainCanvasShell">
    <canvas id="bossFightCanvas" width="900" height="400" tabindex="0" style="image-rendering:pixelated;outline:none;"></canvas>
    <div id="siegeCanvasInput" style="display:none;"></div>
    <div id="teacherCodeInput" style="display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-30%);z-index:10;">
        <form id="teacherCodeForm" autocomplete="off" style="display:flex;gap:4px;">
            <input id="teacherCodeField" type="password" placeholder="Ange lärarkod..."
                   style="width:200px;padding:8px 12px;font-size:14px;font-weight:700;font-family:monospace;
                          background:rgba(10,16,32,0.95);color:#00cc00;border:2px solid #00aa00;
                          border-radius:4px;outline:none;caret-color:#00ff00;" />
            <button type="submit" style="padding:8px 16px;font-size:12px;font-weight:800;font-family:monospace;
                                         background:#1a4a1a;color:#00ff00;border:2px solid #00aa00;
                                         border-radius:4px;cursor:pointer;">LOGGA IN</button>
        </form>
        <p id="teacherCodeError" style="color:#ff4040;font:bold 11px monospace;margin:6px 0 0 0;text-align:center;"></p>
    </div>
    <div id="duelPrepOverlay" style="display:none;position:absolute;inset:0;background:rgba(15,23,42,.62);color:#fff;font-weight:800;font-size:1.4rem;align-items:center;justify-content:center;text-align:center;padding:1rem;">Gör dig redo...</div>
    <div id="groupResultOverlay" style="display:none;position:absolute;inset:0;background:rgba(15,23,42,.72);color:#fff;font-weight:900;font-size:3rem;align-items:center;justify-content:center;text-align:center;padding:1rem;letter-spacing:.04em;text-transform:uppercase;">DU VANN!</div>
    <div id="groupBattleFeed" style="display:none;position:absolute;left:10px;right:10px;bottom:10px;color:#fff;background:rgba(15,23,42,.58);border-radius:10px;padding:.45rem .6rem;font-weight:700;"></div>
</section>

<div class="game-shell" id="gameShell" style="display:none;">
    <section class="hero-panel" id="heroPanel" style="display:none;">
        <div>
            <p class="kicker">Web Edition</p>
            <h1>GlosTrainer</h1>
            <p class="subtitle">Träna glosor, bygg streak och klå bossfighten.</p>
            <p id="authStatusText" class="subtitle"></p>
            <div class="auth-actions" style="display:none;">
                <a id="loginLink" class="btn btn-primary" href="/Auth/Login">Logga in</a><a id="registerLink" class="btn btn-outline-primary" href="/Auth/Register">Registrera</a>
                <a id="teacherLoginLink" class="btn teacher-login-cta" href="/Auth/TeacherLogin">Lärar-login</a>
                <a id="logoutLink" class="btn btn-outline-secondary" href="/auth/logout">Logga ut</a>
                <a id="adminLink" class="btn btn-outline-dark" href="/Admin/LegacyLinks">Admin</a>
            </div>
        </div>
        <div class="hero-stats">
            <div><span>Level</span><strong id="levelValue">1</strong></div>
            <div><span>XP</span><strong id="xpValue">0</strong></div>
            <div><span>Coins</span><strong id="coinsValue">0</strong></div>
            <div><span>Streak</span><strong id="streakValue">0</strong></div>
        </div>
    </section>

    <section class="controls-panel" id="controlsPanel" style="display:none;">
        <div class="train-cta-shell" style="display:flex;align-items:center;gap:4px;">
            <button id="weekPrevBtn" type="button" style="padding:4px 8px;font-size:1.1rem;border:1px solid #b8d2e9;border-radius:6px;background:#f1f5f9;cursor:pointer;">&#9664;</button>
            <select id="weekSelect" class="train-week-select" style="flex:1;"></select>
            <button id="weekNextBtn" type="button" style="padding:4px 8px;font-size:1.1rem;border:1px solid #b8d2e9;border-radius:6px;background:#f1f5f9;cursor:pointer;">&#9654;</button>
        </div>
        <label for="appLanguageSelect">Språk</label>
        <select id="appLanguageSelect">
            <option value="english">Engelska</option>
        </select>
        <button id="createGroupFightButton" type="button" class="primary-cta" style="background:#16a34a;color:#fff;">Skapa gruppfight / bossfight</button>
        <a id="teacherQuickLoginButton" class="btn teacher-login-cta" href="/Auth/TeacherLogin">Lärar-login</a>
        <button id="toggleModeButton" type="button" class="primary-cta boss-cta" style="display:none;">&#9760; Starta Bossfight</button>
        <button id="fortressModeButton" type="button" class="primary-cta fortress-cta" style="display:none;"><span class="cta-icon" aria-hidden="true">&#x1F6E1;</span> Byggförsvar</button>

        <label id="userSelectLabel" for="userSelect">Användare</label>
        <select id="userSelect"></select>
        <label id="guestNameLabel" for="guestNameInput" style="display:none;">Ditt namn</label>
        <input id="guestNameInput" type="text" placeholder="Skriv ditt namn..." style="display:none;" />

        <label for="bossSelect" style="display:none;">Boss</label>
        <select id="bossSelect" style="display:none;"></select>

        <label for="playerAvatarSelect">Spelarbild</label>
        <select id="playerAvatarSelect"></select>
        <img id="playerAvatarPreview" alt="Spelarbild" style="width:80px;height:80px;border-radius:10px;object-fit:cover;border:1px solid #b8d2e9;background:#fff;" />
    </section>

    <section class="combat-panel" id="combatPanel" style="display:none;">
        <div class="hp-card">
            <h2>Du</h2>
            <div class="hp-bar"><div id="playerHpBar"></div></div>
            <p id="playerHpText">100 / 100 HP</p>
            <img id="playerAvatarCard" alt="Spelare" style="width:68px;height:68px;border-radius:999px;object-fit:cover;border:2px solid #b8d2e9;background:#fff;display:none;margin-top:.35rem;" />
        </div>
        <div class="hp-card">
            <h2 id="bossName">Boss</h2>
            <div class="hp-bar"><div id="bossHpBar"></div></div>
            <p id="bossHpText">100 / 100 HP</p>
            <img id="bossAvatarCard" alt="Boss" style="width:68px;height:68px;border-radius:999px;object-fit:cover;border:2px solid #ef4444;background:#fff;display:none;margin-top:.35rem;" />
            <p id="bossTimerText">Tid till krasch: -</p>
            <p id="bossWordsLeftText">Glosor kvar: -</p>
            <div id="wordsProgressWrap" class="words-progress" style="display:none;">
                <div class="words-progress-track">
                    <div id="wordsProgressFill"></div>
                </div>
                <p id="wordsProgressText">0%</p>
            </div>
        </div>
    </section>

    <section id="groupBattleBoard" class="card-panel" style="display:none;">
        <p class="question-label">Gruppfight-status</p>
        <div id="groupBattleStatusText"></div>
        <div id="groupBattleProgressWrap" class="words-progress" style="display:none;">
            <div class="words-progress-track">
                <div id="groupBattleProgressFill"></div>
            </div>
            <p id="groupBattleProgressText">0%</p>
        </div>
        <ul id="groupBattlePlayers" class="leaderboard-list"></ul>
    </section>

    <section class="card-panel" id="questionPanel" style="display:none;">
        <button id="flipDirectionButton" type="button" style="display:block;width:100%;padding:.7rem;margin-bottom:.6rem;font-size:1rem;font-weight:800;border:none;border-radius:10px;background:#16a34a;color:#fff;cursor:pointer;">Klicka för att välja ordning: English → Svenska</button>
        <p id="questionLabel" class="question-label" style="display:none;"></p>
        <p class="question-word" id="questionWord">Laddar glosor...</p>
        <form id="answerForm" autocomplete="off">
            <input id="answerInput" type="text" placeholder="Skriv svaret..." style="font-size:1.15rem;padding:.85rem 1rem;" />
            <button type="submit">Svar</button>
            <div id="specialCharsRow" style="display:none;margin-top:.4rem;gap:.3rem;flex-wrap:wrap;"></div>
        </form>
        <div style="display:flex;gap:.6rem;margin-top:.6rem;">
            <button id="nextWordButton" type="button" class="ghost">Ny glosa</button>
            <button id="resetSessionButton" type="button" class="ghost" style="color:#ef4444;border-color:#ef4444;">Nollställ</button>
        </div>
        <div style="display:flex;gap:.6rem;margin-top:.6rem;">
            <button id="startSiegeButton" type="button" style="flex:1;padding:.7rem;font-size:1rem;font-weight:800;border:none;border-radius:10px;background:linear-gradient(135deg,#1e40af,#7c3aed);color:#fff;cursor:pointer;letter-spacing:.03em;">⚔️ SIEGE BATTLE</button>
            <button id="startAdventureButton" type="button" style="flex:1;padding:.7rem;font-size:1rem;font-weight:800;border:none;border-radius:10px;background:linear-gradient(135deg,#065f46,#059669);color:#fff;cursor:pointer;letter-spacing:.03em;">🗡️ ADVENTURE</button>
        </div>
        <div id="trainProgressWrap" style="display:none;margin-top:.6rem;">
            <div style="position:relative;width:100%;height:32px;border-radius:10px;overflow:hidden;background:#334155;border:2px solid #475569;">
                <div id="trainProgressBar" style="height:100%;width:0%;border-radius:8px;background:linear-gradient(90deg,#ef4444 0%,#eab308 50%,#22c55e 100%);transition:width .35s ease;"></div>
                <span id="trainProgressText" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.95rem;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6);">0%</span>
            </div>
        </div>
        <p id="feedbackText" class="feedback"></p>
    </section>

    <section class="card-panel">
        <p class="question-label">Utmaningar</p>
        <ul id="challengeInboxList" class="leaderboard-list"></ul>
    </section>

    <!-- popup moved outside game-shell, see below -->

    <section class="card-panel">
        <p class="question-label">Inloggade nu</p>
        <ul id="onlineUsersList" class="leaderboard-list"></ul>
    </section>

    <section class="card-panel">
        <p class="question-label">Slottsnivåer (vecka)</p>
        <div id="castleTree" class="castle-tree"></div>
    </section>

    <section class="card-panel">
        <p class="question-label">Veckostatistik</p>
        <div id="weekStatsContainer"></div>
    </section>

    <section class="card-panel">
        <p class="question-label">Topplista</p>
        <select id="leaderboardWeekSelect" style="margin-bottom:.6rem;max-width:320px;">
            <option value="">Alla veckor</option>
        </select>
        <ul id="leaderboardList" class="leaderboard-list"></ul>
    </section>

    <section class="powerups-panel" style="display:none;">
        <button id="hintButton" type="button">Hint (-15 coins)</button>
        <button id="healButton" type="button">Heal (-20 coins)</button>
        <button id="doubleButton" type="button">Double Hit (-25 coins)</button>
        <button id="resetButton" type="button" class="ghost">Nollställ</button>
        <button id="soundToggleButton" type="button" class="ghost">Ljud: På</button>
        <p id="hintText"></p>
    </section>

    <section class="hero-panel">
        <div style="width:100%">
            <p class="kicker">Tillfälliga glosor (gästläge)</p>
            <textarea id="tempWordsInput" rows="4" style="width:100%; border:1px solid #b8d2e9; border-radius:10px; padding:0.75rem;" placeholder="Skriv en rad per glosa, t.ex:
handla - go shopping
ryggsack: backpack"></textarea>
            <div style="display:flex; gap:.6rem; margin-top:.6rem; flex-wrap:wrap;">
                <button id="tempWordsAddButton" type="button">Lägg till temporärt</button>
            </div>
            <p id="tempWordsStatus" class="feedback"></p>
        </div>
    </section>

    <section class="hero-panel" style="display:none;">
        <div style="width:100%">
            <p class="kicker">AI Import</p>
            <h2 style="margin-top:0">Klistra, släpp eller ladda upp glosor</h2>
            <textarea id="aiInput" rows="6" style="width:100%; border:1px solid #b8d2e9; border-radius:10px; padding:0.75rem;" placeholder="Exempel:
handla - go shopping
ryggsack: backpack"></textarea>
            <div style="display:flex; gap:.6rem; margin-top:.6rem; flex-wrap:wrap;">
                <select id="targetLanguageSelect">
                    <option value="english">Engelska</option>
                    <option value="swedish">Svenska</option>
                    <option value="spanish">Spanska</option>
                    <option value="german">Tyska</option>
                    <option value="french">Franska</option>
                    <option value="japanese">Japanska</option>
                </select>
                <input id="aiFilesInput" type="file" multiple accept="image/*,.txt,.csv,.md,.json" />
            </div>
            <div style="display:flex; gap:.6rem; margin-top:.6rem; flex-wrap:wrap;">
                <button id="aiParseButton" type="button">Läs med AI</button>
                <button id="aiSaveButton" type="button" class="ghost">Spara till vald vecka</button>
                <button id="aiCreateWeekButton" type="button" class="ghost">Skapa ny vecka från AI</button>
            </div>
            <p id="aiStatus" class="feedback"></p>
        </div>
    </section>

    <section class="hero-panel" style="display:none;">
        <div style="width:100%">
            <p class="kicker">Veckoöversikt</p>
            <h2 style="margin-top:0">Alla glosveckor</h2>
            <div id="weeksOverview"></div>
        </div>
    </section>

    <section class="log-panel" style="display:none;">
        <ul id="eventLog"></ul>
    </section>
</div>

<div id="groupFightPopup" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,.92);z-index:99999;overflow-y:auto;padding:1rem;">
    <div style="background:#fff;border-radius:16px;max-width:940px;width:94%;padding:1rem;border:2px solid #7aa7d0;">
        <h3 style="margin-top:0;">Skapa gruppfight / bossfight</h3>
        <p style="margin:.2rem 0 .7rem 0;">Välj språk, vecka, lag och fyll på med bottar.</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:.8rem;">
            <div>
                <label for="groupFightLanguageSelect" style="font-weight:700;display:block;margin-bottom:.25rem;">Språk</label>
                <select id="groupFightLanguageSelect"></select>
            </div>
            <div>
                <label for="groupFightWeekSelect" style="font-weight:700;display:block;margin-bottom:.25rem;">Vecka</label>
                <select id="groupFightWeekSelect"></select>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;">
            <div style="grid-column:1 / -1;border:1px solid #d6e4f3;border-radius:12px;padding:.6rem;">
                <h4 style="margin:0 0 .5rem 0;">Tillgängliga spelare</h4>
                <ul id="groupPoolList" class="leaderboard-list"></ul>
            </div>
            <div style="border:1px solid #d6e4f3;border-radius:12px;padding:.6rem;">
                <h4 style="margin:0 0 .5rem 0;">Ditt lag</h4>
                <ul id="groupTeamAList" class="leaderboard-list"></ul>
            </div>
            <div style="border:1px solid #d6e4f3;border-radius:12px;padding:.6rem;">
                <h4 style="margin:0 0 .5rem 0;">Motståndarlag</h4>
                <ul id="groupTeamBList" class="leaderboard-list"></ul>
            </div>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem;">
            <button id="groupFightCreateButton" type="button" style="background:#16a34a;">Skapa</button>
            <button id="groupFightCancelButton" type="button" style="background:#475569;">Avbryt</button>
        </div>
    </div>
</div>
