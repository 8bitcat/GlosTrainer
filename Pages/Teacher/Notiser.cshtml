@page
@model GlosTrainer.Web.Pages.Teacher.NotiserModel
@{
    ViewData["Title"] = "Notiser";
}

<style>
  .admin-card {
    background: #fff;
    border: 1px solid #dde6ef;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }
  .admin-card h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #5a7a93;
  }
  .admin-row {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-bottom: .75rem;
  }
  .admin-col {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    flex: 1;
    min-width: 140px;
  }
  .admin-col label {
    font-size: .8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #5a7a93;
  }
  .admin-col select,
  .admin-col input {
    width: 100%;
  }
  .check-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .6rem;
    font-weight: 600;
  }
  .push-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .9rem;
  }
  .push-table th, .push-table td {
    text-align: left;
    padding: .4rem .5rem;
    border-bottom: 1px solid #e8eef4;
  }
  .push-table th {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #5a7a93;
  }
  #notisStatus {
    margin: .75rem 0 0;
    min-height: 1.4rem;
    font-weight: 600;
  }
  .cron-url {
    font-family: monospace;
    font-size: .8rem;
    word-break: break-all;
    background: #f1f5f9;
    border: 1px solid #dde6ef;
    border-radius: 6px;
    padding: .5rem .6rem;
  }
</style>

<div class="game-shell">
    <section class="hero-panel">
        <div style="width:100%">
            <p class="kicker">Larare</p>
            <h1>Notiser</h1>
            <p class="subtitle">Styr push-notiser: ny läxa, påminnelser och manuella utskick. <a href="/Teacher/Weeks">&larr; Tillbaka till glosverktyget</a></p>

            <div style="max-width:820px;margin-top:1.25rem;">

                <div class="admin-card">
                    <h3>Automatik</h3>
                    <div class="check-row">
                        <input type="checkbox" id="cfgNotifyNewWeek" />
                        <label for="cfgNotifyNewWeek">Skicka notis till alla när en ny läxa läggs upp</label>
                    </div>
                    <div class="check-row">
                        <input type="checkbox" id="cfgReminderEnabled" />
                        <label for="cfgReminderEnabled">Daglig påminnelse till de som inte nått målet</label>
                    </div>
                    <div class="admin-row">
                        <div class="admin-col">
                            <label for="cfgReminderHour">Tidigast kl (svensk tid)</label>
                            <select id="cfgReminderHour"></select>
                        </div>
                        <div class="admin-col">
                            <label for="cfgReminderWeek">Läxa att kolla</label>
                            <select id="cfgReminderWeek">
                                <option value="">Senaste läxan (automatiskt)</option>
                            </select>
                        </div>
                        <div class="admin-col">
                            <label for="cfgRequiredPerfects">Antal 100%-rundor som krävs</label>
                            <input id="cfgRequiredPerfects" type="number" min="1" max="50" value="5" />
                        </div>
                    </div>
                    <p style="font-size:.85rem;color:#5a7a93;margin:.25rem 0 .75rem;">
                        Påminnelsen skickas max en gång per dag, efter vald tid, till spelare som inte har klarat läxan
                        (100% rätt) så många gånger som krävs. Övriga slipper notisen.
                    </p>
                    <button id="saveConfigBtn" type="button" class="btn btn-primary">Spara inställningar</button>
                    <button id="runRemindersBtn" type="button" class="btn btn-outline-secondary">Kör påminnelse-koll nu</button>
                </div>

                <div class="admin-card">
                    <h3>Skicka notis nu</h3>
                    <div class="admin-row">
                        <div class="admin-col">
                            <label for="sendTitle">Titel</label>
                            <input id="sendTitle" type="text" placeholder="T.ex. Glöm inte glosorna!" maxlength="80" />
                        </div>
                        <div class="admin-col">
                            <label for="sendTarget">Till</label>
                            <select id="sendTarget">
                                <option value="">Alla</option>
                            </select>
                        </div>
                    </div>
                    <div class="admin-row">
                        <div class="admin-col">
                            <label for="sendBody">Meddelande</label>
                            <input id="sendBody" type="text" placeholder="Text i notisen..." maxlength="200" />
                        </div>
                    </div>
                    <button id="sendPushBtn" type="button" class="btn btn-primary">Skicka</button>
                </div>

                <div class="admin-card">
                    <h3>Prenumeranter</h3>
                    <table class="push-table">
                        <thead>
                            <tr><th>Namn</th><th>Senast sedd</th><th>Fel</th><th></th></tr>
                        </thead>
                        <tbody id="subsBody">
                            <tr><td colspan="4">Laddar...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="admin-card">
                    <h3>Extern väckning (cron)</h3>
                    <p style="font-size:.85rem;color:#5a7a93;">
                        Hostingen kan söva appen när ingen besöker sidan — då tystnar den inbyggda schemaläggaren.
                        Låt en extern tjänst (GitHub Actions eller cron-job.org) anropa denna URL var 30:e minut
                        på eftermiddagen, så väcks appen och skickar påminnelsen vid rätt tid:
                    </p>
                    <div id="cronUrl" class="cron-url">Laddar...</div>
                </div>

                <p id="notisStatus"></p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
(function () {
  "use strict";

  var statusEl = document.getElementById("notisStatus");

  function setStatus(text, ok) {
    statusEl.textContent = text;
    statusEl.style.color = ok ? "#15803d" : "#b91c1c";
  }

  async function api(url, options) {
    var response = await fetch(url, options);
    if (!response.ok) {
      var message = "HTTP " + response.status;
      try { message = (await response.json()).error || message; } catch (_) {}
      throw new Error(message);
    }
    return response.json();
  }

  var hourSelect = document.getElementById("cfgReminderHour");
  for (var h = 0; h < 24; h++) {
    var option = document.createElement("option");
    option.value = String(h);
    option.textContent = (h < 10 ? "0" + h : h) + ":00";
    hourSelect.appendChild(option);
  }

  function formatWhen(iso) {
    if (!iso) return "-";
    var d = new Date(iso.endsWith("Z") ? iso : iso + "Z");
    return d.toLocaleString("sv-SE", { dateStyle: "short", timeStyle: "short" });
  }

  async function load() {
    try {
      var data = await api("/api/push/admin/overview");

      document.getElementById("cfgNotifyNewWeek").checked = !!data.config.notifyOnNewWeek;
      document.getElementById("cfgReminderEnabled").checked = !!data.config.reminderEnabled;
      hourSelect.value = String(data.config.reminderHour);
      document.getElementById("cfgRequiredPerfects").value = data.config.reminderRequiredPerfects;

      var weekSelect = document.getElementById("cfgReminderWeek");
      while (weekSelect.options.length > 1) weekSelect.remove(1);
      data.weeks.forEach(function (week) {
        var opt = document.createElement("option");
        opt.value = week.id;
        opt.textContent = week.weekName + " (" + week.wordCount + " glosor)";
        weekSelect.appendChild(opt);
      });
      weekSelect.value = data.config.reminderWeekId || "";

      var targetSelect = document.getElementById("sendTarget");
      while (targetSelect.options.length > 1) targetSelect.remove(1);
      var seen = {};
      data.subscriptions.forEach(function (sub) {
        if (!sub.userProfileId || seen[sub.userProfileId]) return;
        seen[sub.userProfileId] = true;
        var opt = document.createElement("option");
        opt.value = sub.userProfileId;
        opt.textContent = sub.displayName || "(namnlös)";
        targetSelect.appendChild(opt);
      });

      var tbody = document.getElementById("subsBody");
      tbody.innerHTML = "";
      if (data.subscriptions.length === 0) {
        tbody.innerHTML = "<tr><td colspan='4'>Inga prenumeranter ännu. Be spelarna trycka på klockan 🔔 i appen.</td></tr>";
      }
      data.subscriptions.forEach(function (sub) {
        var tr = document.createElement("tr");
        var device = /iPhone|iPad/.test(sub.userAgent || "") ? " 📱" : "";
        tr.innerHTML =
          "<td>" + (sub.displayName || "(namnlös)") + device + "</td>" +
          "<td>" + formatWhen(sub.lastSeenUtc) + "</td>" +
          "<td>" + sub.failCount + "</td>" +
          "<td><button type='button' class='btn btn-sm btn-outline-danger' data-id='" + sub.id + "'>Ta bort</button></td>";
        tr.querySelector("button").addEventListener("click", async function () {
          if (!confirm("Ta bort prenumerationen för " + (sub.displayName || "(namnlös)") + "?")) return;
          try {
            await api("/api/push/admin/subscriptions/" + sub.id, { method: "DELETE" });
            setStatus("Prenumerationen togs bort.", true);
            load();
          } catch (error) {
            setStatus("Kunde inte ta bort: " + error.message, false);
          }
        });
        tbody.appendChild(tr);
      });

      document.getElementById("cronUrl").textContent = data.cronUrl;
    } catch (error) {
      setStatus("Kunde inte ladda: " + error.message, false);
    }
  }

  document.getElementById("saveConfigBtn").addEventListener("click", async function () {
    try {
      await api("/api/push/admin/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          notifyOnNewWeek: document.getElementById("cfgNotifyNewWeek").checked,
          reminderEnabled: document.getElementById("cfgReminderEnabled").checked,
          reminderHour: parseInt(hourSelect.value, 10),
          reminderWeekId: document.getElementById("cfgReminderWeek").value || null,
          reminderRequiredPerfects: parseInt(document.getElementById("cfgRequiredPerfects").value, 10) || 1
        })
      });
      setStatus("Inställningarna sparades.", true);
    } catch (error) {
      setStatus("Kunde inte spara: " + error.message, false);
    }
  });

  document.getElementById("runRemindersBtn").addEventListener("click", async function () {
    setStatus("Kör påminnelse-koll...", true);
    try {
      var result = await api("/api/push/admin/run-reminders", { method: "POST" });
      if (result.ran) {
        var names = (result.details || [])
          .map(function (d) { return d.name + " " + d.pct + "%" + (d.paminde ? " → notis" : " ✓"); })
          .join(", ");
        setStatus("Klart! Läxa: \"" + result.week + "\" — " + result.sent + " notiser skickade. " + names, true);
      } else {
        setStatus("Kördes inte: " + result.reason, false);
      }
      load();
    } catch (error) {
      setStatus("Fel: " + error.message, false);
    }
  });

  document.getElementById("sendPushBtn").addEventListener("click", async function () {
    try {
      var result = await api("/api/push/admin/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: document.getElementById("sendTitle").value,
          body: document.getElementById("sendBody").value,
          profileId: document.getElementById("sendTarget").value || null
        })
      });
      setStatus("Skickade " + result.sent + " notiser.", true);
    } catch (error) {
      setStatus("Kunde inte skicka: " + error.message, false);
    }
  });

  load();
})();
</script>
}
